# UYARI: Aşağıdaki değerler yalnızca yerel demo içindir. Production'da güçlü parola,
# ayrı kullanıcı ve secret yönetimi kullanın. Gerçek secret bu dosyaya yazılmaz.
#
# Kullanım: cp .env.example .env  (isteğe bağlı; compose varsayılanları da çalışır)
# .env dosyasını commit etmeyin (.gitignore).

# RabbitMQ Management + AMQP (demo)
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Producer HTTP port (host)
PRODUCER_PORT=5080

# Ortam
ASPNETCORE_ENVIRONMENT=Development
DOTNET_ENVIRONMENT=Development
